# Settings for compose.yaml. Copy to .env (git-ignored) and fill in.

# Checkout of github.com/SushiTuna/talkie-voice-server. Its own .env holds the voice server's
# secrets (DEPLOY.md step 12) and is passed to the container.
VOICE_SERVER_DIR=../talkie-voice-server

# Cloudflare Tunnel token (dashboard: Networking → Tunnels → your tunnel). Treat it like a password.
TUNNEL_TOKEN=
